{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghost-shift",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start's handler plus the cron below (src/server.ts).
  "main": "src/server.ts",
  // Every 30 minutes the Worker places Night Shift's due checkouts (docs/guides/night-shift.md).
  // One of the 5 cron triggers the free plan allows.
  "triggers": {
    "crons": ["*/30 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  // Rate limits. Counts are approximate across locations; the code picks which binding to call.
  // HEALTH_LIMITER caps /health/database at 10 requests per 10 seconds per IP.
  // API_LIMITER caps each signed-in user on /api/v1 at 60 requests a minute.
  "ratelimits": [
    {
      "name": "HEALTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 10 },
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
