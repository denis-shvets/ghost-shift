{
  "name": "ghost-shift",
  "version": "0.0.0",
  "private": true,
  "author": "Denis Shvets <denis.shvets.a@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:generate": "drizzle-kit generate",
    "db:seed-users": "node --env-file-if-exists=.dev.vars scripts/seed-users.ts",
    "cf:types": "wrangler types --include-runtime=false",
    "mcp:developer": "node --env-file-if-exists=.dev.vars scripts/mcp-developer.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "supabase": "2.121.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.14.0"
}
