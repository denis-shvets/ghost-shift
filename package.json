{
  "name": "ghost-shift",
  "version": "0.0.0",
  "private": true,
  "author": "Denis Shvets <denis.shvets.a@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:generate": "drizzle-kit generate",
    "db:seed-users": "node --env-file-if-exists=.dev.vars scripts/seed-users.ts",
    "db:generate-seed": "node scripts/generate-seed-orders.ts",
    "cf:types": "wrangler types --include-runtime=false",
    "mcp:developer": "node --env-file-if-exists=.dev.vars scripts/mcp-developer.ts",
    "mcp:agent": "node --env-file-if-exists=.dev.vars scripts/mcp-agent.ts",
    "mcp:agent:hosted": "node --env-file-if-exists=.hosted.vars scripts/mcp-agent.ts --hosted",
    "night-shift:plan": "node --env-file-if-exists=.dev.vars scripts/night-shift.ts plan",
    "night-shift:plan:hosted": "node --env-file=.hosted.vars scripts/night-shift.ts plan --hosted",
    "night-shift:upload": "node --env-file-if-exists=.dev.vars scripts/night-shift.ts upload",
    "night-shift:upload:hosted": "node --env-file=.hosted.vars scripts/night-shift.ts upload --hosted",
    "night-shift:schema": "node scripts/night-shift.ts schema",
    "orders:cron": "node --env-file-if-exists=.dev.vars scripts/order-cron.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@faker-js/faker": "10.6.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.14.0"
}
